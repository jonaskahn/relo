coverage.out
cover.out
coverage.html
*.out
*.test
*.prof
*.pprof
*.coverprofile
profile.cov

# Go workspace (this module is standalone)
go.work
go.work.sum

# Debug builds
cmd/relo/__debug_bin*
__debug_bin*

# Env
.env

# OS
.DS_Store
