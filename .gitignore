# Build output
/dist/
/release/
/relo
/relo.exe
coverage.out

# Merge leftovers. Git stops before applying a merge that conflicts, and the
# resolve is manual, so these survive a rebase or a rebase --abort.
*.orig
*.rej

# Local dev state (VS Code debug home, repo-local state root)
/.dev/
/.relo/
/config.toml

# Downloaded models.dev build seed; `make seed` writes it, releases embed it.
/daemon/internal/adapters/modelsdev/seeddata/modelsdev.json.gz

# Local traffic capture proxy for debugging upstream requests (never commit)
/debugger/

# Secrets
.env
.env.*
*.p12
*.pfx
*.mobileprovision
signing/
.signing/

# Python (root packaging scripts)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# IDE / editor
.idea/
.fleet/
.cursor/
*.code-workspace
*.swp
*.swo
*~

# VS Code: commit the shared config, ignore everything else
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# OS
.DS_Store
._*
.AppleDouble
Desktop.ini
Thumbs.db

# State (never commit user data)
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Local indexes / agent tooling
.codegraph/
.impeccable/
.claude/
.codex/
RTK.md

# Dependency lock files (never committed). Go keeps go.sum: it is a
# checksum manifest the toolchain requires, not a package-manager lock.
package-lock.json
npm-shrinkwrap.json
yarn.lock
pnpm-lock.yaml
bun.lock
bun.lockb
deno.lock
Pipfile.lock
poetry.lock
uv.lock
composer.lock
Gemfile.lock

# Logs
*.log
npm-debug.log*
.pnpm-store/
node_modules/
.cloudflare/cache
